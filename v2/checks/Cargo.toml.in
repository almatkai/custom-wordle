[package]
name = "custom-wordle-beta-contract-check"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false

[lib]
path = "../checks/lib.rs"

[dependencies]
tezbar-custom-wordle-v2 = { path = ".." }
serde_json = "=1.0.140"
tokio = { version = "=1.44.2", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.19.1"
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.27"
tauri = { path = "tauri-stub" }

[[test]]
name = "contracts"
path = "../checks/tests/contracts.rs"
